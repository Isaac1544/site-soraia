---
import '../styles/global.css';
import { navigation, site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isPreview = import.meta.env.PUBLIC_SITE_READY !== 'true';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f1ee" />
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | {site.name} — {site.profession}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    {isPreview && <div class="preview-banner">Prévia em desenvolvimento — conteúdo e imagens sujeitos à revisão da profissional.</div>}
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Soraia Medeiros, página inicial">
          <span class="brand-mark" aria-hidden="true">SM</span>
          <span class="brand-text"><strong>{site.name}</strong><small>{site.profession} · {site.crp}</small></span>
        </a>
        <nav class="desktop-nav" aria-label="Navegação principal">
          {navigation.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-contact" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Conversar</a>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Navegação principal no celular">
            {navigation.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-name">{site.name}</p>
          <p>{site.profession} · {site.crp}</p>
          <p>Atendimento psicológico individual para pessoas adultas.</p>
        </div>
        <div>
          <h2>Entre em contato</h2>
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp: {site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
        <div>
          <h2>Informações</h2>
          <a href="/atendimento-online/">Atendimento online</a>
          <a href="/atendimento-presencial/">Atendimento presencial</a>
          <a href="/privacidade/">Privacidade</a>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Atendimento mediante contato prévio.</span></div>
    </footer>
  </body>
</html>
