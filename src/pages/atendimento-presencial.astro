---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactBand from '../components/ContactBand.astro';
import { locations } from '../data/site';
---
<BaseLayout title="Atendimento presencial" description="Consultórios para atendimento psicológico presencial na Avenida Paulista, em São Paulo, e em Alphaville, Barueri.">
  <PageIntro eyebrow="Modalidade presencial" title="Um lugar para encontrar tempo e espaço para si." description="O atendimento presencial acontece mediante combinação de local e horário. Conheça as duas regiões em que Soraia atende." />
  <section class="section"><div class="container"><div class="location-grid">{locations.map((location) => <article class="location-card"><p class="eyebrow">Consultório</p><h2>{location.name}</h2><address>{location.address}</address><p>{location.note}</p><a class="text-link" href={location.maps} target="_blank" rel="noopener noreferrer">Ver trajeto no Google Maps</a></article>)}</div><p style="margin-top: 1.5rem">O número da sala e as orientações finais de acesso são informados diretamente após a combinação do atendimento.</p></div></section>
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">Antes da visita</p><h2>Confirme o local e o horário.</h2></div><div><p class="lead">As sessões têm duração de 50 minutos. A disponibilidade em cada consultório deve ser confirmada com a profissional antes do deslocamento.</p><p>Se preferir atendimento à distância, conheça também a modalidade online.</p><a class="text-link" href="/atendimento-online/">Veja o atendimento online</a></div></div></section>
  <ContactBand title="Quer saber sobre o atendimento presencial?" text="Entre em contato para consultar disponibilidade e receber as orientações de chegada." />
</BaseLayout>
